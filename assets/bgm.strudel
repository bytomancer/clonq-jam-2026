// tuning: (C4-D4-Eb4-G4-Ab4)
let koto = cat(
    "<g39 ~ >*2",
).note().sound("gm_koto").gain(0.8)

// tuning: sawmill (G4-D3-G3-C4-D4) g D G C D
let banjo = cat(
    "<c4 d4 c4 d4 g4 c4 d4 g4>*8",
    // "<d4 c4 g3 d3 [d3,g3,c4,d4]@2 g4 [d3,g3,c4,d4]@2>*8",
).note().sound("gm_banjo").gain(0.7)

// tuning: (G3-D4-A4-E5)
let fiddle = cat(
    "<g3>"
).sound("gm_fiddle").gain(0.5)

// tuning: (D4-A4)
let erhu = cat(
    "c4",
    "c4",
    "ab3",
    "g3",
).note().sound("gm_cello").gain(0.95)
    .room(.9).roomsize(1)

let woodblock = cat(
    "c3 ~ c3 ~",
    "c3 ~ c3 c3",
    "c3 ~ c3 ~",
    "c3 ~ c3 c3",
).note().sound("gm_woodblock").gain(2.5)

let bottle = cat(
    "c3 ~ c3 ~",
    "c3 ~ c3 ~",
    "ab3 ~ ab3 ~",
    "g3 ~ g3 ~",
).note().sound("gm_blown_bottle").gain(1.5)

let section01 = stack(
    koto,
    banjo,
    fiddle,
    // erhu,
    // woodblock,
    // bottle,
)

let cpm = 128 / 4

arrange(
    [8, section01]
).cpm(cpm)
