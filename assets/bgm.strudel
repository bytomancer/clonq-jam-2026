
// tuning: (C4-D4-Eb4-G4-Ab4)
let koto = cat(
    "< ~@8 d4@2 eb4@2 g4@2 c5@2 >*16",
    "<[d4,g4]>"
)
    .note()
    .sound("gm_koto")
    .gain(0.8)

// tuning: sawmill (g4-D3-G3-C4-D4)
let banjo = cat(
    // "<c4 d4 c4 d4 g4 c4 d4 g4>*8",
    "<d4 g5>*2",
    "<[d3,g3,d4,d4] g5>*2",
)
    .note()
    .sound("gm_banjo")
    .gain(0.7)

// tuning: (G3-D4-A4-E5)
let fiddle = cat(
    "<a4>"
)
    .sound("gm_fiddle")
    .gain(0.5)

// tuning: (D4-A4)
let erhu = cat(
    // "<a5 eb5> * 2",
    // "<d4>",
    "<d6 a5> * 2",
    "<b5>",
)
    .note()
    .sound("gm_cello")
    .pattack("<.1>")
    // .pdecay("<.1>")
    .vib("<6:.25>")
    .gain(0.95)
    .room(.3)
    .roomsize(1)

let woodblock = cat(
    "c4 ~ c4 ~",
    "c4 ~ c4 c4",
)
    .note()
    .sound("gm_woodblock")
    .gain(2.5)

let bottle = cat(
    "c3 ~ c3 ~",
)
    .note()
    .sound("gm_blown_bottle")
    .gain(1.5)

let section01 = stack(
    // chordref,
    // chordprog,
    // koto,
    // banjo,
    // fiddle,
    erhu,
    // woodblock,
    // bottle,
)

let cpm = 128 / 4

arrange(
    [1, section01]
)
    .cpm(cpm)
