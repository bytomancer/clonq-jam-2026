// banjo tuning: sawmill (g5-D3-G3-C4-D4)
// koto tuning: (C4-D4-Eb4-G4-Ab4)
// fiddle tuning: (G3-D4-A4-E5)
// shamisen tuning: (D3 A3 D4)

let banjo = cat(
    "<~>",
    "<d4@2 [d3,g3,d4,d4] g5>*4",
    "<d4@2 [d3,g3,d4,d4] g5>*4",
    "<d4@2 [d3,g3,d4,d4] g5>*4",

    "<d4 a4 d4 a4 g5 d4 a4 g5>*8",
    "<d4@2 [d3,a4,e4,d4] g5>*4",
    "<d4 g4 d4 g4 g5 d4 g4 g5>*8",
    "<g4 d4 g4 d4 g5 g4 d4 g5>*8",
    // "<d4@2 [d3,g4,e4,d4] g5>*4",

    "<c4@2 [d3,g3,c4,d4] g5>*4",
    "<c4@2 [d3,g3,c4,d4] g5>*4",
)
    .note()
    .sound("gm_banjo")
    .gain(0.7)

let koto = cat(
    "< ~@4 d4 eb4 g4 c5 >*8",
    "<[d4,g4]>",
    "< ~@4 d4 eb4 g4 c5 >*8",
    "<[d4,g4]>",


    "<[d4,g4]>",
    "<d4 e4 a4 e4>*4",
    "<[d4,e4,a4]>",
    "<d4 g4 ab4 g4>*4",

    "<d4@2 g4@2 d4@2 g4@2>*8",
    "<d4@2 g4@2 d4@2 g4@2>*8",
)
    .note()
    .sound("gm_koto")
    .gain(0.8)


let fiddle = cat(
    "< ~ >",
    "<g3@4 d4@4>*8",
    "<g3@2 d4@2 g4@2 eb4@2>*8",
    "<g3@2 d4@2 g4@2 d5@2>*8",

    "<g4 eb4 d4 g4 a4 g4 eb4 d4>*8",
    "<g4@2 eb4@2 d4@4>*8",
    "<g3@2 d4@2 g4@2 eb4@2>*8",
    "<ab4 g4@2 g4 g4@2 g4 eb4>*8",

    "<[d4,a4] a4/2 g3/2 a4/2 g3/2 c4 d4>*8",
    "<d4@2 [d4,a4]@2 a4@2 d4@2>*8",
)
    .note()
    .sound("gm_fiddle")
    .vibrato("1:.03")
    .gain(.8)

let shamisen = cat(
    "<c4 g3 d3 c3> * 4",
    "<[c3,g3,c4] ~> * 2",
    "<c4 g3 d3 c3> * 4",
    "<[c3,g3,c4] ~> * 2",

    "<g3@2 g3 g3> * 4",
    "<[d3,g3,d4] ~> * 2",
    "<c4 g3 d3 c3> * 4",
    "<[c3,g3,c4] ~> * 2",

    "<c4 d4 g3 c3> * 4",
    "<c4 d4 g3 c3> * 4",
)
    .note()
    .sound("gm_shamisen")
    .pattack("<.1>")
    // .pdecay("<.1>")
    .vib("<6:.25>")
    .gain(0.95)
    .room(.3)
    .roomsize(1)

let woodblock = cat(
    "d4 ~ d4 ~",
    "d4 ~ d4 d4",
)
    .note()
    .sound("gm_woodblock")
    .gain(2.5)

let bottle = cat(
    "d3 ~ d3 ~",
)
    .note()
    .sound("gm_blown_bottle")
    .gain(2.6)

let section01 = stack(
    // chordref,
    // chordprog,
    banjo,
    koto,
    fiddle,
    shamisen,
    woodblock,
    bottle,
)

let cpm = 160 / 4

arrange(
    [1, section01]
)
    .cpm(cpm)
