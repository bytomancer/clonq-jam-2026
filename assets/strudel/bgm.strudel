// banjo tuning: sawmill (g4-D3-G3-C4-D4)
let banjo_intro = cat(
    "<~>",
    "<d4@2 [d3,g3,c4,d4] g4>*4",
    "<d4@2 [d3,g3,c4,d4] g4>*4",
    "<d4@2 [d3,g3,c4,d4] g4>*4",

    "<d4 c4 d4 c4 g4 d4 c4 g4>*8",
    "<d4@2 [d3,a3,c4,e4] g4>*8",
    "<d4 g3 d4 g3 g4 d4 g3 g4>*8",
    "<d4@2 [d3,g3,c4,d4] g4>*8",

    "<g3 ~ d3 ~>*8",
    "<g3 ~ d3 ~>*8",
    "<a3 ~ c4 ~>*8",
    "<a3 ~ c4 ~>*8",

    "<a3@2 [~,a3,c4,e4] g4>*4",
    "<a3@2 [~,a3,c4,e4] g4>*4",
    "<a3@2 [~,g3,e4,e4] g4>*2",
    "<a3@2 [~,g3,e4,e4] g4>*2",
)
    .note()
    .sound("gm_banjo")
    .gain(0.15)

// banjo tuning: sawmill (g4-D3-G3-C4-D4)
let banjo_core = cat(
    "<d4@2 [d3,g3,c4,d4] g4>*4",
    "<d4@2 [d3,g3,c4,d4] g4>*4",
    "<d4@2 [d3,g3,c4,d4] g4>*4",
    "<d4@2 [d3,g3,c4,d4] g4>*4",

    "<d4 c4 d4 c4 g4 d4 c4 g4>*8",
    "<d4@2 [d3,a3,c4,e4] g4>*8",
    "<d4 g3 d4 g3 g4 d4 g3 g4>*8",
    "<d4@2 [d3,g3,c4,d4] g4>*8",

    "<g3 ~ d3 ~>*8",
    "<g3 ~ d3 ~>*8",
    "<a3 ~ c4 ~>*8",
    "<a3 ~ c4 ~>*8",

    "<a3@2 [~,a3,c4,e4] g4>*4",
    "<a3@2 [~,a3,c4,e4] g4>*4",
    "<a3@2 [~,g3,e4,e4] g4>*2",
    "<a3@2 [~,g3,e4,e4] g4>*2",
)
    .note()
    .sound("gm_banjo")
    .gain(0.15)

// koto tuning: (C4-D4-Eb4-G4-Ab4)
let koto_intro = cat(
    "< ~@4 d4 eb4 g4 c5 >*8",
    "<[d4,g4]>",
    "< ~@4 d4 eb4 g4 c5 >*8",
    "<[d4,g4]>",

    "<[d4,g4]>",
    "<d4 e4 a4 e4>*4",
    "<[d4,e4,a4]>",
    "<d4 g4 ab4 g4>*4",

    "<[d4,g4]>",
    "<d4 e4 a4 e4>*4",
    "<[c4,e4,g4]>",
    "<c4 e4 c4 e4>*4",

    "<[c4,g4]>",
    "<[c4,g4]>",
    "<[d4,g4]>",
    "<[d4,g4]>",

    // "<d4@2 g4@2 d4@2 g4@2>*8",
    // "<d4@2 g4@2 d4@2 g4@2>*8",
)
    .note()
    .sound("gm_koto")
    .gain(0.16)

// koto tuning: (C4-D4-Eb4-G4-Ab4)
let koto_core = cat(
    "< c5 eb4 g4 d4 eb4 g4 c5 ab4 >*8",
    "<[d4,g4]>",
    "< c5 eb4 g4 d4 eb4 g4 c5 ab4 >*8",
    "<[d4,g4]>",

    "<[d4,g4]>",
    "<d4 e4 a4 e4>*4",
    "<[d4,e4,a4]>",
    "<d4 g4 ab4 g4>*4",

    "<[d4,g4]>",
    "<d4 e4 a4 e4>*4",
    "<[c4,e4,g4]>",
    "<c4 e4 c4 e4>*4",

    "<a4@2 g4@2 a4 d4 g4@2>*8",
    "<a4@2 g4@2 a4 d4 g4@2>*8",
    "<d4@2 g4@2 d4@2 g4@2>*8",
    "<d4@2 g4@2 d4@2 g4@2>*8",
)
    .note()
    .sound("gm_koto")
    .gain(0.16)

// fiddle tuning: (G3-D4-A4-E5)
let fiddle_intro = cat(
    // "< ~ >",

    "<~>",
    "<~>",
    "<~>",
    "<~>",

    "<~>",
    "<~>",
    "<~>",
    "<~>",

    "<~>",
    "<g3@4 d4@4>*8",
    "<g3@2 c4@2 g4@2 e5@2>*8", //ceg
    "<e4@2 g4@2 c5@2 e5@2>*8",

    //[a3,c4,e4,g4]
    "<a4 c4 e4 g4 e4 g4 c4 a5>*8",
    "<a4@2 e4@2 d4@4>*8",
    //[e3,g3,b3] d is the 7th
    "<e4 g4@2 b4 g4@2 e5 g4>*8",
    "<e4@2 g4@2 b4@2 [d4,e5]@2>*8",

    // "<[d4,a4] a4/2 g3/2 a4/2 g3/2 c4 d4>*8",
    // "<d4@2 [d4,a4]@2 a4@2 d4@2>*8",
)
    .note()
    .sound("gm_fiddle")
    .vibrato("1:.03")
    .gain(.1)

// fiddle tuning: (G3-D4-A4-E5)
let fiddle_core = cat(
    "<g3@3 ~ g4@2 ~ ~>*8",
    "<g3@3 ~ g4@2 ~ ~>*8",
    "<g3@3 ~ g4@2 ~ ~>*8",
    "<g3@3 ~ g4@2 ~ ~>*8",

    "<g3@3 ~ g4@2 ~ ~>*8",
    "<g3@3 ~ g4@2 ~ ~>*8",
    "<g3@3 ~ g4@2 ~ ~>*8",
    "<g3@3 ~ g4@2 ~ ~>*8",

    "<g5 c4 e4 a4 c4 g4 a4 e4>*8", //aceg
    "<g3@4 d4@4>*8",
    "<g3@2 c4@2 g4@2 e5@2>*8",
    "<e4@2 g4@2 c5@2 e5@2>*8",

    //[a3,c4,e4,g4]
    "<a4 c4 e4 g4 e4 g4 c4 a5>*8",
    "<a4@2 e4@2 d4@4>*8",
    //[e3,g3,b3] d is the 7th
    "<e4 g4@2 b4 g4@2 e5 g4>*8",
    "<e4@2 g4@2 b4@2 [d4,e5]@2>*8",

    // "<[d4,a4] a4/2 g3/2 a4/2 g3/2 c4 d4>*8",
    // "<d4@2 [d4,a4]@2 a4@2 d4@2>*8",
)
    .note()
    .sound("gm_fiddle")
    .vibrato("1:.03")
    .gain(.1)

// shamisen tuning: (D3 A3 D4)
let shamisen_intro = cat(
    "<~>",
    "<d4 c3 d3 c3> * 4",
    "<[d3,d4] ~> * 2",
    "<~>",

    "<~>",
    "<d4 c3 d3 c3> * 4",
    "<[d3,d4] ~> * 2",
    "<~>",

    "<~>",
    "<d4 c3 d3 c3> * 4",
    "<[d3,d4] ~> * 2",
    "<~>",

    "<d3 g4 d4 g4> * 4", //d3,g3,c4,d4,g4
    "<d3 g4 d4 g4> * 4",
    "<e3 c4 e4 c4> * 4", //ceg
    "<e3 c4 e4 c4> * 4", //ceg
)
    .note()
    .sound("gm_shamisen")
    // .pattack("<.1>")
    // .pdecay("<.1>")
    .gain(0.17)

// shamisen tuning: (D3 A3 D4)
let shamisen_core = cat(
    // dgc
    "<~>",
    "<d4 c3 d3 c3> * 4",
    "<[d3,d4] ~> * 2",
    "<~>",

    "<~>",
    "<d4 c3 d3 c3> * 4",
    "<[d3,d4] ~> * 2",
    "<~>",

    "<~>",
    "<d4 c3 d3 c3> * 4",
    "<[d3,d4] ~> * 2",
    "<~>",

    "<a3@2 a3 g4> * 4", // aceg
    "<a3 g3 a4 g4> * 4",
    "<e3@2 e4 e4> * 4", // egb
    "<e3 d3 e4@2> * 4",
)
    .note()
    .sound("gm_shamisen")
    // .pattack("<.1>")
    // .pdecay("<.1>")
    .gain(0.17)

let woodblock = cat(
    "d4 ~ d4 ~",
    "d4 ~ d4 d4",
)
    .note()
    .sound("gm_woodblock")
    .gain(.15)

let bottle = cat(
    "g3 ~ eb3 ~",
)
    .note()
    .sound("gm_blown_bottle")
    .gain(.07)

let section01 = stack(
    banjo_intro,
    koto_intro,
    fiddle_intro,
    shamisen_intro,
    woodblock,
    bottle
)

let section02 = stack(
    banjo_core,
    koto_core,
    fiddle_core,
    shamisen_core,
    woodblock,
    bottle
)

let cpm = 160 / 4
arrange(
    [16, section01],
    [16 * 3, section02],
).cpm(cpm)
